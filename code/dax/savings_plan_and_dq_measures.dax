-- Savings Plan: uso, copertura, risparmio teorico
SP Used Cost      = CALCULATE(SUM(Costs[EffectiveCost]), Costs[CommitmentDiscountType] = "Savings Plan", Costs[CommitmentDiscountStatus] = "Used")
SP Unused Cost    = CALCULATE(SUM(Costs[EffectiveCost]), Costs[CommitmentDiscountType] = "Savings Plan", Costs[CommitmentDiscountStatus] = "Unused")
VM On-Demand Cost = CALCULATE(SUM(Costs[EffectiveCost]), Costs[x_SkuMeterCategory] = "Virtual Machines", Costs[CommitmentDiscountType] = "")
SP Coverage %     = DIVIDE([SP Used Cost], [SP Used Cost] + [VM On-Demand Cost])

-- Sconto medio EMPIRICO, pesato sul costo, calcolato sugli SP già usati (rispetta il filtro regione/sottoscrizione)
SP Average Discount % =
    DIVIDE(
        SUMX(FILTER(Costs, Costs[CommitmentDiscountStatus] = "Used"),
             Costs[x_CommitmentDiscountPercent] * Costs[EffectiveCost]),
        CALCULATE(SUM(Costs[EffectiveCost]), Costs[CommitmentDiscountStatus] = "Used"))
SP Theoretical Additional Savings = [SP Eligible On-Demand Cost] * [SP Average Discount %]

-- Data quality: "trust scorecard" da consultare prima di ogni round di acquisto
DQ Stale VMs =
    COUNTROWS(FILTER(Registry,
        Registry[Deleted] <> "YES"
        && ISBLANK(LOOKUPVALUE(VmInventory[id], VmInventory[id], Registry[ResID]))))
DQ ARG VMs Not In Registry =
    COUNTROWS(FILTER(VmInventory,
        ISBLANK(LOOKUPVALUE(Registry[ResID], Registry[ResID], VmInventory[id]))))
DQ Last Cost Date = MAX(Costs[ChargePeriodEnd])   -- se in ritardo di >2 giorni la pipeline si è fermata
